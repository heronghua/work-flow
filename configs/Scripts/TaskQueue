#!/bin/bash
# ================================================================
#   File Name: TaskQueue
#   Author: He Ronghua
#   Mail: heronghua1989@126.com
#   Created Time: Mon, Sep 14, 2026  8:15:25 PM
# ================================================================
set -eo pipefail
# -----------------------------------------------
# Configuration
# -----------------------------------------------
DEBUG=false
USE_INOTIFY=true
#24h
TASK_TIMEOUT_SEC=86400
POLLING_INTERVAL=10

is_termux() {
    [[ -d "/data/data/com.termux/files/usr" ]] ||
    [[ -n "$TERMUX_VERSION" ]] ||
    [[ "$PREFIX" == "/data/data/com.termux/files/usr"* ]] ||
    { [[ $(uname -o) == "Android" ]] && command -v pkg >/dev/null; }
}

if ! is_termux ; then
   TMP_DIR="/tmp"
else
   TMP_DIR="${PREFIX}"
fi

LOG_FILE="${TMP_DIR}/$(basename "$0").log"
TASK_QUEUE_DIR="${HOME}/.taskqueue"
TASK_FAIL_DIR="${HOME}/.taskqueue_fail"
TASK_LOG_DIR="${HOME}/.taskqueue_log"

mkdir -p "${TASK_QUEUE_DIR}" "${TASK_FAIL_DIR}" "${TASK_LOG_DIR}" || {
    echo "[ERROR] Failed to create task queue directories"
    exit 1
}

# -----------------------------------------------
# Logging functions (Time, PID)
# -----------------------------------------------
log_debug() {
    if [[ "$DEBUG" == true ]]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [PID:$$] [DEBUG] $*" | tee -a "$LOG_FILE"
    fi
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [PID:$$] [INFO ] $*" | tee -a "$LOG_FILE"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [PID:$$] [ERROR] $*" | tee -a "$LOG_FILE" >&2
}

# -----------------------------------------------
# consume_one_task: process single task file
# -----------------------------------------------
consume_one_task() {
    local first_task_id="$1"
    local task_file="${TASK_QUEUE_DIR}/${first_task_id}"
    local task_logfile="${TASK_LOG_DIR}/${first_task_id}.log"

    if [[ ! -f "${task_file}" ]]; then
        return 0
    fi
    if ! first_task_content=$(base64 --decode < "${task_file}"); then
        log_error "task ${first_task_id} base64 decode failed, move to fail dir"
        mv -f "${task_file}" "${TASK_FAIL_DIR}/" || true
        return 0
    fi

    log_info "executing ${first_task_id}, content=\"${first_task_content}\", task_log=${task_logfile}"

    # --------------------------
    # Execute task command with timeout protection
    # Task stdout/stderr redirect to independent task log file, not mix with script main log
    # --------------------------
    EXIT_CODE=0
    if ! timeout "${TASK_TIMEOUT_SEC}" bash -c "${first_task_content}" 2>&1|tee -a "${task_logfile}" ; then
        EXIT_CODE=${PIPESTATUS[0]}
    fi

    if [[ "${EXIT_CODE}" -eq 0 ]]; then
        log_info "task ${first_task_id} finished, content=\"${first_task_content}\", task_log=${task_logfile}"
        log_debug "task ${first_task_id} execute success, remove task file"
        rm -f "${task_file}"
    else
        log_error "task ${first_task_id} execute failed, exit code ${EXIT_CODE}, content=\"${first_task_content}\", task_log=${task_logfile}, move to fail dir"
        mv -f "${task_file}" "${TASK_FAIL_DIR}/" || true
    fi
}

# -----------------------------------------------
# scan_and_consume_all: scan directory and consume all pending tasks in FIFO order
# -----------------------------------------------
scan_and_consume_all() {
    while true; do
        # Fixed: avoid SIGPIPE signal 13, zero‑delimited read first entry
        first_task_file=$(find "${TASK_QUEUE_DIR}" -maxdepth 1 -type f -print0 | sort -z | { IFS= read -r -d '' line; echo "$line"; })
        first_task_id="${first_task_file##*/}"
        if [[ -z "${first_task_id}" ]]; then
            break
        fi
        consume_one_task "${first_task_id}"
    done
}

# -----------------------------------------------
# Parameter parsing
# -----------------------------------------------
needRun=false
task=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --debug)
            DEBUG=true
            [[ -f "${LOG_FILE}" ]] && touch "${LOG_FILE}"
            shift
            ;;
        --add|-a)
            if [[ -z "${2:-}" ]]; then
                echo "Option $1 requires a task argument."
                exit 1
            fi
            task="$2"
            shift 2
            ;;
        --run|-r)
            needRun=true
            shift
            ;;
        --help)
            echo "Usage: $(basename "$0") [--debug] [--add|-a <task>] [--run|-r] [--help]"
            echo "  --debug                 Enable verbose debug logs"
            echo "  --add, -a               Add a task."
            echo "  --run, -r               Run task queue consumer."
            echo "  --help                  Show this help message"
            exit 0
            ;;
        *)
            log_error "Unknown option: $1"
            exit 1
            ;;
    esac
done

# -----------------------------------------------
# Producer: add new task
# -----------------------------------------------
log_debug "Script started."
if [[ -n "${task}" ]]; then
    log_debug "receive task payload: ${task}"
    prefix_date=$(date +%Y%m%d%H%M%S%N)
    # fix single quote escape for path contains single quote
    escaped_pwd=$(printf "%s" "$PWD" | sed "s/'/'\"'\"'/g")
    task_with_cd="cd '${escaped_pwd}'; ${task}"
    task_encode=$(echo -n "$task_with_cd" | base64)
    echo "${task_encode}" > "${TASK_QUEUE_DIR}/${prefix_date}"
    log_debug "task file created: ${prefix_date}, wrapped with cd to PWD=${PWD}"
    exit 0
fi

# -----------------------------------------------
# Consumer: event‑driven by inotifywait
# -----------------------------------------------
if [[ "${needRun}" == "true" ]]; then
    log_info "task queue consumer started"
    # consume existing leftover tasks on startup
    scan_and_consume_all

    if ! command -v inotifywait >/dev/null 2>&1; then
        log_error "inotifywait not found, fallback to polling mode, interval ${POLLING_INTERVAL}s"
        USE_INOTIFY=false
    fi

    if [[ "${USE_INOTIFY}" == true ]]; then
        log_info "using inotifywait event‑driven mode"
        # loop to restart listener if inotifywait exits unexpectedly
        while true; do
            inotifywait -m -e close_write --format '%f' "${TASK_QUEUE_DIR}" | while read -r new_file; do
                log_debug "detect new closed‑write file: ${new_file}"
                # every time new file arrives, full scan & consume all pending
                scan_and_consume_all
            done
            log_error "inotifywait stopped, restart after 2s"
            sleep 2
        done
    else
        # fallback polling
        while true; do
            scan_and_consume_all
            sleep  ${POLLING_INTERVAL}
        done
    fi
fi

log_debug "Script finished."
exit 0

